@model HotelBookingSystem.Models.ViewModels.BookingViewModel

@{
    ViewData["Title"] = "Create Booking";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-4">Book Room @Model.RoomNumber</h2>

                <div class="mb-4">
                    <p class="mb-1"><strong>Room Number:</strong> @Model.RoomNumber</p>
                    <p class="mb-1"><strong>Room Type:</strong> @Model.RoomTypeName</p>
                    <p class="mb-0"><strong>Price per Night:</strong> ₹@Model.PricePerNight</p>
                </div>

                <form asp-controller="Bookings" asp-action="Create" method="post">
                    <input asp-for="RoomId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CheckInDate" class="form-label"></label>
                        <input asp-for="CheckInDate" type="date" class="form-control" />
                        <span asp-validation-for="CheckInDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CheckOutDate" class="form-label"></label>
                        <input asp-for="CheckOutDate" type="date" class="form-control" />
                        <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GuestCount" class="form-label"></label>
                        <input asp-for="GuestCount" type="number" min="1" value="1" class="form-control" />
                        <span asp-validation-for="GuestCount" class="text-danger"></span>
                    </div>

                    <div class="alert alert-secondary" role="status">
                        <strong>Total Amount:</strong>
                        <span>₹@Model.TotalAmount.ToString("N2")</span>
                        <span class="d-block small text-muted">
                            @Model.TotalNights night at ₹@Model.PricePerNight.ToString("N2") per night.
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Confirm Booking</button>
                        <a asp-controller="Rooms"
                           asp-action="Details"
                           asp-route-id="@Model.RoomId"
                           class="btn btn-secondary">
                            Back to Room Details
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
