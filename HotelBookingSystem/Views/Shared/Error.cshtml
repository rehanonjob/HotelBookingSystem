@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 650px;">
        <div class="card-body p-5">
            <h1 class="display-5 text-danger">Something went wrong</h1>
            <p class="lead mb-4">
                We could not complete your request. Please try again later.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small">
                    If you contact support, provide request ID
                    <code>@Model.RequestId</code>.
                </p>
            }

            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return home</a>
        </div>
    </div>
</div>
