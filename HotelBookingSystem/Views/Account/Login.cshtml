@model HotelBookingSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="account-page py-3 py-md-5">
    <div class="row justify-content-center align-items-stretch g-4">
        <div class="col-12 col-lg-5">
            <div class="account-intro h-100 rounded-4 p-4 p-md-5">
                <span class="account-icon mb-4" aria-hidden="true">⌂</span>
                <p class="text-uppercase small fw-semibold account-label mb-2">Welcome back</p>
                <h1 class="display-6 fw-bold mb-3">Sign in to your account</h1>
                <p class="mb-0">
                    Manage your bookings and continue planning a comfortable stay with us.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-9 col-lg-5">
            <div class="card account-card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h3 mb-2">Login</h2>
                    <p class="text-muted mb-4">Enter your details to continue.</p>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted">New here?</span>
                        <a asp-controller="Account" asp-action="Register" class="fw-semibold"> Create an account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
