@model HotelBookingSystem.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="account-page py-3 py-md-5">
    <div class="row justify-content-center align-items-stretch g-4">
        <div class="col-12 col-lg-5 order-lg-2">
            <div class="account-intro h-100 rounded-4 p-4 p-md-5">
                <span class="account-icon mb-4" aria-hidden="true">+</span>
                <p class="text-uppercase small fw-semibold account-label mb-2">Join us</p>
                <h1 class="display-6 fw-bold mb-3">Create your account</h1>
                <p class="mb-0">
                    Register today to browse rooms, make booking requests, and keep track of your stays.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-9 col-lg-5 order-lg-1">
            <div class="card account-card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h3 mb-2">Register</h2>
                    <p class="text-muted mb-4">It only takes a moment to get started.</p>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control form-control-lg" placeholder="Your full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control form-control-lg" placeholder="Your phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Create a password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirm your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Create Account</button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-controller="Account" asp-action="Login" class="fw-semibold"> Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
