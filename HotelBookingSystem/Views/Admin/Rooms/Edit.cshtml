@using Microsoft.AspNetCore.Mvc.Rendering
@model HotelBookingSystem.Models.ViewModels.EditRoomViewModel

@{
    ViewData["Title"] = "Edit Room";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h2 mb-4">Edit Room</h1>

                <form asp-area="Admin"
                      asp-controller="Rooms"
                      asp-action="Edit"
                      asp-route-id="@Model.RoomId"
                      method="post">
                    <input asp-for="RoomId" type="hidden" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RoomNumber" class="form-label"></label>
                        <input asp-for="RoomNumber" class="form-control" />
                        <span asp-validation-for="RoomNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomTypeId" class="form-label">Room Type</label>
                        <select asp-for="RoomTypeId"
                                asp-items="@(new SelectList(ViewBag.RoomTypes, "RoomTypeId", "TypeName"))"
                                class="form-select">
                            <option value="">-- Select Room Type --</option>
                        </select>
                        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PricePerNight" class="form-label"></label>
                        <input asp-for="PricePerNight" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="PricePerNight" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active Status</label>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Update Room</button>
                        <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
