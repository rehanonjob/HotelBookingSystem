@model IEnumerable<HotelBookingSystem.Models.ViewModels.AdminBookingListViewModel>

@{
    ViewData["Title"] = "Manage Bookings";
}

<h1 class="h2 mb-4">Manage Bookings</h1>

@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="lead">No bookings have been made yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Guest Name</th>
                    <th>Guest Email</th>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Check-in Date</th>
                    <th>Check-out Date</th>
                    <th>Total Nights</th>
                    <th>Total Amount</th>
                    <th>Booking Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.GuestName</td>
                        <td>@booking.GuestEmail</td>
                        <td>@booking.RoomNumber</td>
                        <td>@booking.RoomType</td>
                        <td>@booking.CheckInDate.ToString("dd MMM yyyy")</td>
                        <td>@booking.CheckOutDate.ToString("dd MMM yyyy")</td>
                        <td>@booking.TotalNights</td>
                        <td>₹@booking.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (booking.BookingStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">@booking.BookingStatus</span>
                            }
                            else if (booking.BookingStatus == "Confirmed")
                            {
                                <span class="badge bg-success">@booking.BookingStatus</span>
                            }
                            else if (booking.BookingStatus == "Cancelled")
                            {
                                <span class="badge bg-secondary">@booking.BookingStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@booking.BookingStatus</span>
                            }
                        </td>
                        <td>
                            <a asp-area="Admin"
                               asp-controller="Bookings"
                               asp-action="Details"
                               asp-route-id="@booking.BookingId"
                               class="btn btn-sm btn-outline-secondary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
