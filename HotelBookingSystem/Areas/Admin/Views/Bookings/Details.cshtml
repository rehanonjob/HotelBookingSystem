@model HotelBookingSystem.Models.ViewModels.AdminBookingDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
    var guestPhone = string.IsNullOrWhiteSpace(Model.GuestPhone)
        ? "Not provided"
        : Model.GuestPhone;
}

@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Booking Details</h1>
    <a asp-area="Admin"
       asp-controller="Bookings"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Bookings
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Guest Information</h2>
                <hr />
                <p class="mb-2"><strong>Name:</strong> @Model.GuestName</p>
                <p class="mb-2"><strong>Email:</strong> @Model.GuestEmail</p>
                <p class="mb-0"><strong>Phone:</strong> @guestPhone</p>
            </div>
        </div>

    </div>

    <div class="col-12 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Room Information</h2>
                <hr />
                <p class="mb-2"><strong>Room Number:</strong> @Model.RoomNumber</p>
                <p class="mb-0"><strong>Room Type:</strong> @Model.RoomType</p>
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Booking Information</h2>
                <hr />
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <strong>Booking ID</strong>
                        <p class="mb-0">@Model.BookingId</p>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <strong>Check-in Date</strong>
                        <p class="mb-0">@Model.CheckInDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <strong>Check-out Date</strong>
                        <p class="mb-0">@Model.CheckOutDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <strong>Total Nights</strong>
                        <p class="mb-0">@Model.TotalNights</p>
                    </div>
                    <div class="col-12 col-sm-6">
                        <strong>Total Amount</strong>
                        <p class="mb-0">₹@Model.TotalAmount.ToString("N2")</p>
                    </div>
                    <div class="col-12 col-sm-6">
                        <strong>Booking Status</strong>
                        <p class="mb-0">
                            @if (Model.BookingStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">@Model.BookingStatus</span>
                            }
                            else if (Model.BookingStatus == "Confirmed")
                            {
                                <span class="badge bg-success">@Model.BookingStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.BookingStatus</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h5">Booking Actions</h2>
        <hr />

        @if (Model.BookingStatus == "Pending")
        {
            <form asp-area="Admin"
                  asp-controller="Bookings"
                  asp-action="Confirm"
                  asp-route-id="@Model.BookingId"
                  method="post"
                  class="d-inline-block me-2">
                <button type="submit" class="btn btn-success">Confirm Booking</button>
            </form>
        }

        @if (Model.BookingStatus == "Pending" || Model.BookingStatus == "Confirmed")
        {
            <form asp-area="Admin"
                  asp-controller="Bookings"
                  asp-action="Cancel"
                  asp-route-id="@Model.BookingId"
                  method="post"
                  class="d-inline-block">
                <button type="submit" class="btn btn-danger">Cancel Booking</button>
            </form>
        }
    </div>
</div>
